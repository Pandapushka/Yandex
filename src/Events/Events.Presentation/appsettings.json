{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=events;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "this-is-a-very-long-secret-key-for-jwt-hs256-at-least-32-characters",
    "Issuer": "WebApiEvent",
    "Audience": "WebApiEventApi",
    "LifetimeMinutes": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-booking-consumer"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "EventTtlMinutes": 5,
    "TopEventsTtlMinutes": 10
  }
}
